# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# MongoDB Atlas connection string (free tier). Needed from Phase 1 onward.
MONGODB_URI=

# Long random string used to sign JWTs, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Origin of the Vite dev server / deployed frontend, used for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary (Phase 6 — file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
